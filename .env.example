# ========================================================
# TOPPKO AESTHETICS - ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Resend.com API Key (https://resend.com/api-keys)
# Sign up at resend.com, create an API key with sending permissions and paste it here:
RESEND_API_KEY=

# Target email to receive clinic requisitions
TO_EMAIL=toppkoaesthetic@gmail.com

# Sender email address
# Before verifying a custom domain, use: Toppko Aesthetics <onboarding@resend.dev>
# After verifying your domain (e.g. toppkoaesthetics.com), use: orders@toppkoaesthetics.com
FROM_EMAIL=Toppko Aesthetics <onboarding@resend.dev>

# 2. Google reCAPTCHA v3 Keys (https://www.google.com/recaptcha/admin)
# Register your domain (and localhost for testing) with reCAPTCHA v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

